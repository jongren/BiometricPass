<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- IRON RULE: ZERO Network Permission. Explicitly remove if any library attempts to merge them. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />

    <!-- Biometric hardware authentication -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Camera permission strictly for offline QR Code recovery/migration scanning -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Allow querying launchable apps so the user can bind credentials to installed App packageNames -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".BiometricPassApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BiometricPass">

        <!-- Main Vault Screen -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BiometricPass">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Allow opening received .bpass backup files directly from Quick Share / Files / Downloads -->
            <intent-filter android:label="@string/open_backup_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-biometricpass" />
            </intent-filter>

            <intent-filter android:label="@string/open_backup_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.bpass" />
                <data android:pathPattern=".*\\..*\\.bpass" />
                <data android:pathPattern=".*\\..*\\..*\\.bpass" />
            </intent-filter>

            <intent-filter android:label="@string/open_backup_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-biometricpass" />
            </intent-filter>
        </activity>

        <!-- Transparent BottomSheet for Random Password Generation / Manual Input & Save -->
        <activity
            android:name=".ui.generate.GenerateAndSaveActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BiometricPass.Transparent" />

        <!-- Transparent Biometric Authentication & Vault Picker Overlay -->
        <activity
            android:name=".ui.autofill.AuthAndPickActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BiometricPass.Transparent" />

        <!-- 1x1 Invisible Activity for background-safe Clipboard Clearing on Android 10+ -->
        <activity
            android:name=".util.ClipboardClearActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:theme="@style/Theme.BiometricPass.Transparent" />

        <!-- Receiver for closing the pull-down Quick Access Notification Assistant -->
        <receiver
            android:name=".service.QuickAccessDismissReceiver"
            android:exported="false" />

        <!-- 100% Fallback 2: Floating Text Selection Menu Action (ACTION_PROCESS_TEXT) -->
        <activity
            android:name=".ui.processtext.ProcessTextActivity"
            android:label="@string/process_text_label"
            android:exported="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:theme="@style/Theme.BiometricPass.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Core Module 1: Native AutofillService -->
        <service
            android:name=".autofill.PassAutofillService"
            android:label="@string/autofill_service_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_config" />
        </service>

        <!-- 100% Fallback 1: Quick Settings Tile Service -->
        <service
            android:name=".service.PassTileService"
            android:label="@string/tile_service_label"
            android:icon="@drawable/ic_tile_key"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Local-only Autofill Slot Gate Provider for Android 10 FillUi Dataset Rotation -->
        <provider
            android:name=".autofill.AutofillSlotProvider"
            android:authorities="${applicationId}.autofill_slot"
            android:exported="true" />

        <!-- FileProvider for offline Quick Share (.bpass backup file sharing during device migration) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
